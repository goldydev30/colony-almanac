---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EntryCard from '../components/EntryCard.astro';
import ColonistCard from '../components/ColonistCard.astro';
import { colonists, allEntries, stats, day, formatDate, excerpt } from '../data';
import { url, bg } from '../lib/url';

const latestLogs = allEntries.filter((e) => e.entry.type === 'log').slice(0, 3);

// The week: the seven days ending on the latest dispatch
const end = stats.lastSeen;
const startDate = new Date(`${end}T12:00:00Z`);
startDate.setUTCDate(startDate.getUTCDate() - 6);
const start = startDate.toISOString().slice(0, 10);
const week = allEntries.filter((e) => day(e.entry.at) >= start);
const weekLogs = week.filter((e) => e.entry.type === 'log');
const weekEvents = week.filter((e) => e.entry.type === 'chronicle');
const weekVoices = new Set(week.map((e) => e.colonist.slug)).size;
const highlights = [...new Map(weekLogs.map((e) => [e.colonist.slug, e])).values()].slice(0, 4);
const firstSentence = (t: string) => (t.match(/^.+?[.!?](?=\s|$)/)?.[0] ?? t).trim();

// The month: the calendar month of the latest dispatch
const month = end.slice(0, 7);
const monthEntries = allEntries.filter((e) => e.entry.at.startsWith(month));
const monthEvents = monthEntries.filter((e) => e.entry.type === 'chronicle');
const monthLogs = monthEntries.length - monthEvents.length;
const monthVoices = new Set(monthEntries.map((e) => e.colonist.slug)).size;
const monthEventColonies = new Set(monthEvents.map((e) => e.colonist.slug)).size;
const headline = monthEvents.find((e) => e.entry.type === 'chronicle');
const frontier: [string, string][] = [
  ['fortress-bridge-dusk', 'A Colonist keeps watch on a fortress bridge at dusk as dropships pass overhead'],
  ['shield-wall', 'Red-armoured defenders hold a shield wall against raiders'],
  ['fortress-canyon-night', 'A canyon fortress as night falls'],
  ['canyon-firefight', 'A firefight breaks out across a canyon'],
  ['fortress-canyon-day', 'A fortress built into the canyon walls by day'],
  ['holo-globe', 'A holographic globe glows in the dark'],
];
const headlineFact = headline && headline.entry.type === 'chronicle' ? headline.entry.facts[0] : '';
---
<Base current="today">
  <section class="hero section" style={bg('/assets/art/fortress-night.jpg')}>
    <div class="wrap hero-inner">
      <div class="eyebrow">Survive as one, far from home.</div>
      <h1 class="display">Welcome to the Colony Almanac</h1>
      <p class="lede">
        A collection of daily and weekly logs, chronicles, and memories from top Colonists.
      </p>
      <div class="ctas">
        <a href="#latest" class="btn btn-primary">LATEST LOGS</a>
        <a href={url('/colonists/')} class="btn btn-ghost">THE COLONISTS</a>
      </div>
      <dl class="stats">
        <div><dt class="label">Colonists on record</dt><dd class="display">{stats.colonists}</dd></div>
        <div><dt class="label">Logs filed</dt><dd class="display">{stats.logs.toLocaleString('en-US')}</dd></div>
        <div><dt class="label">Last dispatch</dt><dd class="display">{formatDate(end, { day: 'numeric', month: 'short' })}</dd></div>
      </dl>
    </div>
  </section>

  <section id="latest" class="section grid-tex">
    <div class="wrap">
      <SectionHeader eyebrow={`Logs · ${formatDate(end)}`} title="Latest from the Colony" link={{ href: url('/reports/'), label: 'All entries' }} />
      <div class="entries">
        {latestLogs.map((item) => <EntryCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap digest">
      <article class="panel weekly">
        <div class="eyebrow">This week · {formatDate(start, { day: 'numeric', month: 'short' })} – {formatDate(end, { day: 'numeric', month: 'short' })}</div>
        <h2 class="display">{weekLogs.length} logs and {weekEvents.length} Chronicle events from {weekVoices} Colonists</h2>
        <ol>
          {highlights.map((e) => (
            <li>
              <a href={url(`/colonists/${e.colonist.slug}/`)} class="n">{e.colonist.name}</a>
              <span>{e.entry.type === 'log' && excerpt(firstSentence(e.entry.text), 180)}</span>
            </li>
          ))}
        </ol>
        <a href={url('/reports/')} class="more">Read the week →</a>
      </article>
      <article class="monthly" style={bg('/assets/art/raider-charge.jpg')}>
        <div class="eyebrow">Monthly chronicle · {formatDate(end, { month: 'long', year: 'numeric' })}</div>
        <h2 class="display">{monthEvents.length} events reshaped {monthEventColonies} colonies</h2>
        {headlineFact && <blockquote>{headlineFact}</blockquote>}
        <p>{monthLogs} logs filed this month by the {monthVoices} most active Colonists.</p>
        <a href={url('/reports/?show=chronicle')} class="more">Open the Chronicle →</a>
      </article>
    </div>
  </section>

  <section class="section frontier">
    <div class="wrap">
      <SectionHeader eyebrow="Field photography" title="From the frontier" />
      <ul class="strip">
        {frontier.map(([file, alt]) => (
          <li><img src={url(`/assets/art/${file}.jpg`)} alt={alt} width="768" height="1376" loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeader eyebrow="Registry" title="The Colonists" link={{ href: url('/colonists/'), label: 'Full registry' }} />
      <div class="roster">
        {colonists.slice(0, 12).map((c) => <ColonistCard colonist={c} />)}
      </div>
    </div>
  </section>

  <section id="submit" class="section submit" style={bg('/assets/art/artillery-overlook.jpg')}>
    <div class="wrap">
      <div class="eyebrow">Coming soon · Player submissions</div>
      <h2 class="display">Your colony belongs in the record too.</h2>
      <p>Colonist photos, gear you fabricated, raids you survived. Send them in and the best get filed in the Almanac.</p>
      <a href="#submit" class="btn btn-outline">Get notified</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background-image:
      linear-gradient(90deg, rgba(10, 12, 15, .96) 0%, rgba(10, 12, 15, .78) 42%, rgba(10, 12, 15, .15) 100%),
      var(--bg);
    background-size: cover;
    background-position: right center;
  }
  .hero .hero-inner { padding-block: 120px 96px; gap: 28px; }
  .hero h1 { font-size: clamp(30px, 4.4vw, 52px); line-height: 1.15; max-width: 760px; }
  .lede { margin: 0; font-size: 20px; line-height: 1.55; max-width: 560px; color: var(--text-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .stats {
    margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 180px)); gap: 32px;
    border-top: 1px solid var(--line-strong); padding-top: 24px;
  }
  .stats dd { margin: 8px 0 0; font-size: 26px; }

  .entries { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }

  .digest { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 24px; }
  .digest article { padding: 36px; display: flex; flex-direction: column; gap: 22px; }
  .digest h2 { font-size: 26px; line-height: 1.3; }
  .weekly .eyebrow { color: var(--chronicle); }
  .weekly ol { margin: 0; padding: 0; list-style: none; }
  .weekly li {
    display: flex; flex-direction: column; gap: 6px; padding: 14px 0;
    border-top: 1px solid var(--line); color: var(--text-2); line-height: 1.5;
  }
  .n { font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; color: var(--chronicle); }
  .more { font-weight: 600; padding: 8px 0; margin-top: auto; }
  .monthly {
    min-height: 520px; justify-content: flex-end; border: 1px solid var(--line);
    background-image: linear-gradient(0deg, rgba(10, 12, 15, .96) 25%, rgba(10, 12, 15, .25) 75%), var(--bg);
    background-size: cover; background-position: center;
  }
  .monthly .eyebrow { color: var(--text); }
  .monthly h2 { font-size: 30px; }
  .monthly blockquote { margin: 0; padding-left: 16px; border-left: 2px solid var(--chronicle); font-size: 18px; line-height: 1.5; color: var(--text); max-width: 520px; }
  .monthly p { margin: 0; font-size: 16px; line-height: 1.6; color: #d2d8de; max-width: 480px; }
  .monthly .more { margin-top: 0; }

  .frontier { border-block: 1px solid var(--line); }
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .strip li { border: 1px solid var(--line-strong); overflow: hidden; background: var(--panel); }
  .strip img { display: block; width: 100%; height: auto; aspect-ratio: 768 / 1376; object-fit: cover; transition: transform .4s ease; }
  .strip li:hover img { transform: scale(1.04); }
  @media (max-width: 1000px) {
    .strip { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
    .strip li { flex: 0 0 min(62vw, 240px); scroll-snap-align: start; }
  }
  @media (prefers-reduced-motion: reduce) { .strip img { transition: none; } }
  .roster { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; }

  .submit {
    background-image: linear-gradient(90deg, rgba(10, 12, 15, .95) 30%, rgba(10, 12, 15, .35) 100%), var(--bg);
    background-size: cover; background-position: right center;
  }
  .submit .wrap { gap: 20px; align-items: flex-start; padding-block: 96px; }
  .submit h2 { font-size: 32px; max-width: 620px; line-height: 1.3; }
  .submit p { margin: 0; font-size: 18px; line-height: 1.6; color: var(--text-2); max-width: 520px; }

  @media (max-width: 640px) {
    .hero .hero-inner { padding-block: 72px 56px; }
    .stats { grid-template-columns: 1fr; gap: 16px; }
    .digest article { padding: 24px; }
  }
</style>
