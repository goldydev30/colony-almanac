---
import Base from '../../layouts/Base.astro';
import FilterTabs from '../../components/FilterTabs.astro';
import Portrait from '../../components/Portrait.astro';
import { colonists, getColonist, timelineFor, formatDate, stats, day } from '../../data';
import { url, bg } from '../../lib/url';

export function getStaticPaths() {
  return colonists.map((c) => ({ params: { slug: c.slug } }));
}

const colonist = getColonist(Astro.params.slug!)!;
// Alternate the backdrop between two landscapes so neighbouring files differ
const backdrops = ['/assets/art/fortress-golden.jpg', '/assets/art/dropship-canyon.jpg'];
const backdrop = backdrops[colonists.indexOf(colonist) % backdrops.length];
const timeline = timelineFor(colonist);

const facts: [string, string][] = [
  ['First log', formatDate(colonist.first_seen)],
  ['Latest log', formatDate(colonist.last_seen)],
  ['Logs filed', String(colonist.log_count)],
  ['Chronicle events', String(colonist.chronicle_event_count)],
  ['Active days', String(colonist.active_days)],
  ['Most seen at', colonist.top_places[0] ?? '—'],
];
if (colonist.avatar) facts.unshift(['Faction', colonist.avatar.faction]);
const traitLabel = (k: string) => k.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

// One square per day for the 30 days ending on the latest dispatch
const perDay = new Map<string, number>();
for (const e of timeline) if (e.type === 'log') perDay.set(day(e.at), (perDay.get(day(e.at)) ?? 0) + 1);
const days = Array.from({ length: 30 }, (_, i) => {
  const d = new Date(`${stats.lastSeen}T12:00:00Z`);
  d.setUTCDate(d.getUTCDate() - (29 - i));
  const key = d.toISOString().slice(0, 10);
  const n = perDay.get(key) ?? 0;
  return { key, n, level: n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : 3 };
});
const activeIn30 = days.filter((d) => d.n > 0).length;

const groups: [string, string[]][] = [
  ['Frequent places', colonist.top_places],
  ['Threats faced', colonist.top_threats],
  ['Resources', colonist.top_resources],
];
---
<Base title={colonist.name} current="colonists">
  <div class="backdrop" style={bg(backdrop)}>
  <div class="wrap crumbs label">
    <a href={url('/colonists/')}>Registry</a> / {colonist.name}
  </div>

  <section class="wrap profile">
    <figure class="portrait">
      <Portrait colonist={colonist} class="art" large />
      <figcaption class="label">
        <span>{colonist.avatar ? `Avatar #${colonist.avatar.token_id} · Preview` : 'Avatar art pending'}</span><span class="active">● Active</span>
      </figcaption>
    </figure>
    <div class="file">
      <div class="eyebrow">Colonist file</div>
      <h1 class="display">{colonist.name}</h1>
      {colonist.commander && <p class="commander label">Serving Commander <span>{colonist.commander}</span></p>}
      <blockquote class="quote">“{colonist.quote}”</blockquote>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
      </dl>
      {groups.filter(([, items]) => items.length).map(([title, items]) => (
        <div class="group">
          <h2 class="label">{title}</h2>
          <ul class="tags">{items.map((t) => <li>{t}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
  </div>

  <section class="reports grid-tex">
    <div class="wrap reports-inner">
      <div class="log">
        <div class="log-head">
          <h2 class="display">Field record</h2>
          <FilterTabs target="colonist-log" label="Show" />
        </div>
        <ol id="colonist-log" class="timeline">
          {timeline.map((e) => (
            <li data-type={e.type} class={e.type}>
              <div class="when">{formatDate(e.at)} · {e.type === 'log' ? 'Log' : 'Colony Chronicle'}</div>
              {e.type === 'log'
                ? <p>{e.text}</p>
                : <ul>{e.facts.map((f) => <li>{f}</li>)}</ul>}
            </li>
          ))}
        </ol>
      </div>
      <aside class="side">
        <div class="panel box">
          <h2 class="label">Logs · last 30 days</h2>
          <div class="days">
            {days.map((d) => <span class={`l${d.level}`} title={`${formatDate(d.key)}: ${d.n} log${d.n === 1 ? '' : 's'}`} />)}
          </div>
          <p class="note">Logged on {activeIn30} of the last 30 days, up to {formatDate(stats.lastSeen)}.</p>
        </div>
        <div class="panel box">
          <h2 class="label">Avatar traits</h2>
          {colonist.avatar ? (
            <>
              <p class="saying">“{colonist.avatar.saying}”</p>
              <dl class="traits">
                {Object.entries(colonist.avatar.traits).map(([k, v]) => <div><dt>{traitLabel(k)}</dt><dd>{v}</dd></div>)}
              </dl>
              <p class="note">Preview pairing: this Avatar stands in for the Colonist filed as {colonist.callsign} until the real match is known.</p>
            </>
          ) : (
            <p class="note">Name, portrait, faction and traits will come from the Parallel Avatars collection.</p>
          )}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .backdrop {
    background-image: linear-gradient(180deg, rgba(10, 12, 15, .55) 0%, rgba(10, 12, 15, .9) 240px, var(--ground) 520px), var(--bg);
    background-size: 100% auto; background-repeat: no-repeat; background-position: center top;
  }
  @media (max-width: 900px) { .backdrop { background-size: auto 520px; } }
  .crumbs { padding-top: 24px; letter-spacing: .14em; }
  .crumbs a { color: var(--muted); }
  .profile { display: flex; flex-wrap: wrap; gap: 48px; padding-block: 32px 64px; }
  .portrait { flex: 1 1 320px; max-width: 420px; margin: 0; position: relative; border: 1px solid var(--line-strong); align-self: flex-start; }
  .portrait :global(.art) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; font-size: 48px; }
  .portrait figcaption {
    position: absolute; inset: auto 0 0 0; display: flex; justify-content: space-between;
    padding: 12px 16px; background: rgba(10, 12, 15, .85); letter-spacing: .14em;
  }
  .active { color: var(--accent); }
  .file { flex: 999 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .file h1 { font-size: clamp(32px, 4.6vw, 52px); letter-spacing: .02em; }
  .commander { margin: -6px 0 0; letter-spacing: .16em; }
  .commander span { color: var(--accent); text-transform: none; letter-spacing: .04em; font-size: 13px; }
  .quote {
    margin: 0 0 8px; padding-left: 18px; border-left: 2px solid var(--accent);
    font-size: 21px; line-height: 1.5; color: var(--text); max-width: 680px;
  }
  .facts {
    margin: 0 0 8px; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line-strong);
  }
  .facts div { padding: 16px 18px; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .facts dd { margin: 8px 0 0; font-size: 18px; font-weight: 600; }
  .group { display: flex; flex-direction: column; gap: 10px; }
  .group h2 { margin: 0; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { border: 1px solid var(--line-strong); color: var(--text-2); font-size: 14px; padding: 6px 12px; text-transform: capitalize; }
  .group:first-of-type .tags li { border-color: var(--accent); color: var(--accent); }

  .reports { border-top: 1px solid var(--line); }
  .reports-inner { display: flex; flex-wrap: wrap; gap: 48px; padding-block: 64px 96px; }
  .log { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .log-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .log-head h2 { font-size: 28px; }
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line-strong); }
  .timeline > li { position: relative; padding: 0 0 32px 32px; --c: var(--log); }
  .timeline > li.chronicle { --c: var(--chronicle); }
  .timeline > li::before { content: ''; position: absolute; left: -5px; top: 6px; width: 9px; height: 9px; background: var(--c); }
  .when { font-family: var(--font-mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--c); margin-bottom: 10px; }
  .timeline p, .timeline ul { margin: 0; line-height: 1.65; color: var(--text-2); max-width: 720px; }
  .timeline ul { padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }

  .side { flex: 1 1 300px; display: flex; flex-direction: column; gap: 24px; }
  .box { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .box h2 { margin: 0; letter-spacing: .24em; }
  .days { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; }
  .days span { aspect-ratio: 1; border: 1px solid #2a323b; }
  .l0 { background: var(--well); }
  .l1 { background: color-mix(in srgb, var(--accent) 30%, transparent); }
  .l2 { background: color-mix(in srgb, var(--accent) 60%, transparent); }
  .l3 { background: var(--accent); }
  .saying { margin: 0; font-size: 16px; line-height: 1.5; color: var(--text); }
  .traits { margin: 0; display: flex; flex-direction: column; }
  .traits div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; }
  .traits dt { color: var(--muted); }
  .traits dd { margin: 0; text-align: right; }
  .note { margin: 0; font-size: 14px; line-height: 1.5; color: var(--muted); }
</style>
