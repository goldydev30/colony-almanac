---
import { url } from '../lib/url';
import type { Report } from '../data/types';
import { getColonist } from '../data/placeholder';
import CadenceChip from './CadenceChip.astro';

interface Props { report: Report }
const { report } = Astro.props;
const colonist = getColonist(report.colonist);
---
<article class="panel entry">
  <a href={url(`/colonists/${report.colonist}/`)} class="who">
    {colonist?.image
      ? <img src={url(colonist.image!)} alt="" width="52" height="52" />
      : <span class="placeholder-img thumb" aria-hidden="true">IMG</span>}
    <span class="names">
      <span class="name">{colonist?.name ?? '[Colonist name]'}</span>
      <span class="label">{colonist?.role ?? '[Role]'}</span>
    </span>
  </a>
  <CadenceChip cadence={report.cadence} />
  <p>{report.text}</p>
  <div class="tags label">
    <span>{report.activity}</span>
    <span>{report.location}</span>
  </div>
</article>

<style>
  .entry { padding: 24px; display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: start; }
  .who { display: flex; align-items: center; gap: 14px; color: var(--text); }
  .who img, .thumb { width: 52px; height: 52px; object-fit: cover; border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .thumb { font-size: 10px; }
  .names { display: flex; flex-direction: column; gap: 3px; }
  .name { font-weight: 600; font-size: 17px; }
  p { grid-column: 1 / -1; margin: 0; font-size: 16px; line-height: 1.6; color: var(--text-2); }
  .tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--line); padding-top: 14px; letter-spacing: .08em; }
  .tags span { border: 1px solid var(--line-strong); padding: 4px 8px; }
</style>
