---
import type { DatedEntry } from '../data/types';
import { excerpt, formatDate } from '../data';
import { url } from '../lib/url';
import TypeChip from './TypeChip.astro';
import Portrait from './Portrait.astro';

interface Props { item: DatedEntry }
const { colonist, entry } = Astro.props.item;
---
<article class="panel entry">
  <a href={url(`/colonists/${colonist.slug}/`)} class="who">
    <Portrait colonist={colonist} size={52} class="thumb" />
    <span class="names">
      <span class="name">{colonist.name}</span>
      <span class="label">{formatDate(entry.at)}</span>
    </span>
  </a>
  <TypeChip type={entry.type} />
  {entry.type === 'log'
    ? <p>{excerpt(entry.text, 260)}</p>
    : <ul>{entry.facts.slice(0, 3).map((f) => <li>{f}</li>)}</ul>}
  <div class="tags label">
    {colonist.top_places.slice(0, 2).map((p) => <span>{p}</span>)}
  </div>
</article>

<style>
  .entry { padding: 24px; display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: start; }
  .who { display: flex; align-items: center; gap: 14px; color: var(--text); }
  .who :global(.thumb) { width: 52px; height: 52px; object-fit: cover; border: 1px solid var(--line-strong); border-radius: var(--radius); font-size: 12px; }
  .names { display: flex; flex-direction: column; gap: 3px; }
  .name { font-weight: 600; font-size: 17px; }
  p, ul { grid-column: 1 / -1; margin: 0; font-size: 16px; line-height: 1.6; color: var(--text-2); }
  ul { padding-left: 18px; }
  .tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--line); padding-top: 14px; letter-spacing: .08em; margin-top: auto; }
  .tags span { border: 1px solid var(--line-strong); padding: 4px 8px; }
</style>
